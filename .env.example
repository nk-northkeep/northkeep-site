# Caminho publicado. GitHub Pages do repositório: /northkeep-site/
# Domínio www.northkeep.com.br (depois do cutover): /
VITE_BASE_PATH=/northkeep-site/

# POST https do Formspree. Vazio = o formulário abre mailto.
VITE_FORMSPREE_ENDPOINT=

# Fallback do formulário quando o Formspree não está configurado.
# Vazio = contato@northkeep.com.br, o endereço que a página exibe.
VITE_CONTACT_EMAIL=

# Identificação do controlador na política de privacidade. Vazio = não aparece na página.
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_CNPJ=
VITE_COMPANY_ADDRESS=

# ID vazio ou ausente = a ferramenta não é carregada. Com ID, o script só entra depois do consentimento.
VITE_CLARITY_ID=
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_LINKEDIN_PARTNER_ID=
